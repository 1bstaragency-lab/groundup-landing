# ─────────────────────────────────────────────────────────────────────────────
# grounduP  ·  Environment Variables
# Copy this file to .env and fill in your keys.
# NEVER commit .env — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ───────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Image Generation (pick one — all optional, falls back to demo mode) ───────

# fal.ai  →  https://fal.ai  (recommended: fastest, great for album art)
VITE_FAL_API_KEY=

# OpenAI DALL·E 3  →  https://platform.openai.com  (highest quality, slowest)
VITE_OPENAI_API_KEY=

# Stability AI  →  https://platform.stability.ai  (good quality, affordable)
VITE_STABILITY_API_KEY=

# ── Video Generation (pick one — all optional, falls back to demo mode) ───────

# Runway ML  →  https://runwayml.com  (recommended: best music video aesthetic)
VITE_RUNWAY_API_KEY=

# Kling AI  →  https://klingai.com  (competitive quality, often faster)
VITE_KLING_API_KEY=

# ── Playlist Curator (both required for live Spotify data) ───────────────────
# Get from: https://developer.spotify.com/dashboard  (free, 5 min setup)
# Create an app → copy Client ID + Client Secret. No payment required.
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_CLIENT_SECRET=
